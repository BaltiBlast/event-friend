<section>
  <h1>Creer un evenement</h1>

  <form action="/create-event" method="post">
    <label for="title">
      Titre <sub>obligatoire</sub>
      <input type="text" id="title" name="title" required />
    </label>

    <label for="imageUrl">
      Image <sub>optionnel</sub>
      <input type="url" id="imageUrl" name="imageUrl" placeholder="https://..." />
    </label>

    <div class="create-event-date-time">
      <label for="date">
        Date <sub>obligatoire</sub>
        <input type="date" id="date" name="date" required />
      </label>

      <label for="time">
        Heure <sub>obligatoire</sub>
        <input type="time" id="time" name="time" required />
      </label>
    </div>

    <label for="description">
      Description <sub>obligatoire</sub>
      <textarea id="description" name="description" required></textarea>
    </label>

    <div class="create-event-participants">
      Participants <sub>optionnel</sub>

      <div class="participant-picker">
        <label for="participant-search">
          <input
            type="search"
            id="participant-search"
            placeholder="Rechercher une personne"
            autocomplete="off"
          />
        </label>

        <div id="participant-options" class="participant-options" hidden></div>
      </div>

      <ul id="selected-participants" class="selected-participants"></ul>
    </div>

    <button type="submit">Creer l'evenement</button>
  </form>
</section>
